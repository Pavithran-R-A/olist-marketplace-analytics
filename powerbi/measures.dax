GMV = SUM(fact_orders[gmv])
Orders = DISTINCTCOUNT(fact_orders[order_id])
Customers = DISTINCTCOUNT(fact_orders[customer_unique_id])
AOV = DIVIDE([GMV], [Orders])
Freight = SUM(fact_orders[freight_value])
Freight % = DIVIDE([Freight], [GMV])
Delivered Orders = CALCULATE([Orders], fact_orders[order_status] = "delivered")
Cancelled Orders = CALCULATE([Orders], fact_orders[order_status] = "canceled")
Cancellation Rate = DIVIDE([Cancelled Orders], [Orders])
Late Orders = CALCULATE([Orders], fact_orders[is_late] = TRUE())
Late Delivery Rate = DIVIDE([Late Orders], [Delivered Orders])
Avg Delivery Days = AVERAGE(fact_orders[delivery_days])
Avg Review Score = AVERAGE(fact_orders[review_score])
1-Star Rate = DIVIDE(CALCULATE([Orders], fact_orders[review_score] = 1), CALCULATE([Orders], NOT ISBLANK(fact_orders[review_score])))
Repeat Customers = COUNTROWS(FILTER(VALUES(fact_orders[customer_unique_id]), CALCULATE([Orders]) > 1))
Repeat Customer Rate = DIVIDE([Repeat Customers], [Customers])
GMV Previous Month = CALCULATE([GMV], DATEADD(dim_date[date], -1, MONTH))
GMV MoM % = DIVIDE([GMV] - [GMV Previous Month], [GMV Previous Month])

